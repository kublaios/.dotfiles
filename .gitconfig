# This is Git's per-user configuration file.
[user]
	name = Kubilay Erdogan
[core]
	excludesfile = ~/.gitignore_global
	attributesfile = ~/.gitattributes
	gpgsign = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[commit]
	gpgsign = true
[init]
    defaultBranch = main
